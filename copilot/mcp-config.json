{
	"mcpServers": {
		"airbyte": {
			"type": "http",
			"url": "https://mcp.airbyte.com/mcp",
			"tools": ["*"]
		},
		"astro-docs": {
			"type": "http",
			"url": "https://mcp.docs.astro.build/mcp",
			"tools": ["*"]
		},
		"chrome-devtools": {
			"type": "stdio",
			"command": "pnx",
			"args": ["chrome-devtools-mcp"],
			"tools": ["*"]
		},
		"chrome-devtools-polypane": {
			"type": "stdio",
			"command": "pnx",
			"args": [
				"chrome-devtools-mcp",
				"--browserUrl=http://127.0.0.1:5858",
				"--experimentalIncludeAllPages=true",
				"--categoryEmulation=false"
			],
			"tools": ["*"]
		},
		"cloudflare": {
			"type": "http",
			"url": "https://mcp.cloudflare.com/mcp",
			"tools": ["*"]
		},
		"figma": {
			"type": "http",
			"url": "https://mcp.figma.com/mcp",
			"tools": ["*"]
		},
		"heroui-pro": {
			"type": "http",
			"url": "https://mcp.heroui.pro/mcp",
			"headers": {
				"x-heroui-personal-token": "${HEROUI_PERSONAL_TOKEN}"
			},
			"tools": ["*"]
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp",
			"tools": ["*"]
		},
		"react-aria": {
			"type": "stdio",
			"command": "pnx",
			"args": ["@react-aria/mcp"],
			"tools": ["*"]
		},
		"resend": {
			"type": "http",
			"url": "https://mcp.resend.com/mcp",
			"tools": ["*"]
		},
		"supabase": {
			"type": "http",
			"url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
			"tools": ["*"]
		}
	}
}
