{
	"mcpServers": {
		"ambient-context": {
			"type": "stdio",
			"command": "/Applications/Ambient Context.app/Contents/MacOS/ambient-context",
			"args": ["mcp"],
			"tools": ["*"]
		},
		"astro-docs": {
			"type": "http",
			"url": "https://mcp.docs.astro.build/mcp",
			"tools": ["*"]
		},
		"cloudflare": {
			"type": "http",
			"url": "https://mcp.cloudflare.com/mcp",
			"tools": ["*"]
		},
		"figma": {
			"type": "http",
			"url": "https://mcp.figma.com/mcp",
			"tools": ["*"]
		},
		"heroui-pro": {
			"type": "http",
			"url": "https://mcp.heroui.pro/mcp",
			"headers": {
				"x-heroui-personal-token": "${HEROUI_PERSONAL_TOKEN}"
			},
			"tools": ["*"]
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp",
			"tools": ["*"]
		},
		"react-aria": {
			"type": "stdio",
			"command": "pnx",
			"args": ["@react-aria/mcp"],
			"tools": ["*"]
		},
		"sentry": {
			"type": "http",
			"url": "https://mcp.sentry.dev/mcp",
			"tools": ["*"]
		},
		"supabase": {
			"type": "http",
			"url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
			"tools": ["*"]
		},
		"supabase-local": {
			"type": "http",
			"url": "http://localhost:54321/mcp",
			"tools": ["*"]
		}
	}
}
